# Supabase — publishable key is safe for browser use (protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# App — admin notification email
VITE_ADMIN_EMAIL=

# Seeder — run: node --env-file=.env seed-user.mjs  (local only, never commit real values)
SEED_EMAIL=
SEED_PASSWORD=

# Smoke tests — run: node --env-file=.env test-login.mjs  (local only, never commit real values)
# TEST_EMAIL=
# TEST_PASSWORD=
